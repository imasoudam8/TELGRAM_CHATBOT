# ==============================================================================
# Anonymous Telegram Matching & Chat Bot - Staging Environment Template
# ==============================================================================
# Copy to .env.staging on the isolated staging host ONLY:
#   cp .env.staging.example .env.staging && chmod 600 .env.staging
# NEVER commit .env.staging and NEVER reuse production tokens or passwords here.

# Strict staging mode (enforces Alembic head alignment, get_me() check, and strong secrets)
APP_ENV=staging
APP_NAME="Anonymous Telegram Matching & Chat Bot [Staging]"
TIMEZONE="Asia/Tehran"

# Daily free Chat Coins quota allocated per staging user per Tehran business date
DAILY_FREE_COINS_QUOTA=4

# Dedicated Staging Bot Token from @BotFather (separate bot from production!)
# Must NOT contain EXAMPLE, PLACEHOLDER, CHANGEME, or YOUR_ in staging.
BOT_TOKEN="123456789:PLACEHOLDER_REPLACE_WITH_DEDICATED_STAGING_BOT_TOKEN"

# Isolated Staging PostgreSQL 16 Database (separate DB/host/volume from production)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=bot_staging_user
POSTGRES_PASSWORD=PLACEHOLDER_STRONG_STAGING_DB_PASSWORD_16_CHARS
POSTGRES_DB=matching_bot_staging
POSTGRES_ECHO=false
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT=30

# Isolated Staging Redis 7 Instance / DB Index
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=PLACEHOLDER_STRONG_STAGING_REDIS_PASS_16_CHARS
REDIS_MAX_CONNECTIONS=20
REDIS_TIMEOUT=5

# Startup Migration Readiness & Internal Loopback Health Endpoint
REQUIRE_MIGRATIONS_CURRENT=true
HEALTH_SERVER_ENABLED=true
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080

# Structured Logging (INFO recommended for UAT; secret redaction always active)
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Optional Staging-Only Backup Verification Path (separate from production backups)
# BACKUP_DIR=/var/backups/matching_bot_staging
# BACKUP_DAILY_RETENTION=3
# BACKUP_MONTHLY_RETENTION=1
