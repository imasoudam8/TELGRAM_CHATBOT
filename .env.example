# ==============================================================================
# Anonymous Telegram Matching & Chat Bot - Environment Configuration Example
# ==============================================================================
# Copy to .env for local development or inject securely via environment/secret
# manager in production. NEVER commit real .env files or production credentials.

# Application Environment: development | staging | production | test
APP_ENV=development

# Application Identity
APP_NAME="Anonymous Telegram Matching & Chat Bot"

# Business Timezone (timestamps stored in UTC; business calculations use this)
TIMEZONE="Asia/Tehran"

# Daily free Chat Coins quota allocated per user per Tehran business date
DAILY_FREE_COINS_QUOTA=4

# Telegram Bot Configuration (REQUIRED)
# Obtain from @BotFather on Telegram (format: <bot_id>:<secret_hash>)
# Production MUST NOT contain EXAMPLE, TEST, PLACEHOLDER, or CHANGEME markers.
BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_EXAMPLE_TOKEN"

# PostgreSQL Configuration (REQUIRED in production: strong >= 12 char password)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_dev_password
POSTGRES_DB=matching_bot
POSTGRES_ECHO=false
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_POOL_TIMEOUT=30

# Redis Configuration (REQUIRED in production: non-empty >= 12 char password)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20
REDIS_TIMEOUT=5

# Startup Migration Readiness & Internal Health Endpoint
# When unset: automatically true in production/staging, false in development/test
# REQUIRE_MIGRATIONS_CURRENT=true
HEALTH_SERVER_ENABLED=false
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080

# Logging Configuration
# Levels: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
LOG_FORMAT=json
# Optional rotating log file path (container stdout already rotates via Docker driver)
# LOG_FILE_PATH=/var/log/matching_bot/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# PostgreSQL Backup & Off-Server Recovery Configuration (Optional / Operator Managed)
# BACKUP_DIR=/var/backups/matching_bot
# BACKUP_DAILY_RETENTION=7
# BACKUP_MONTHLY_RETENTION=1
# BACKUP_GPG_RECIPIENT=ops-backups@example.com
# BACKUP_GPG_PASSPHRASE_FILE=/run/secrets/backup_gpg_passphrase
# BACKUP_REMOTE_TARGET=s3://your-offsite-bucket/matching_bot
# BACKUP_REMOTE_COMMAND=rclone
